<mujoco model="ball_navigation_arena">
  <compiler angle="radian" coordinate="local"/>

  <option gravity="0 0 -9.81" timestep="0.005">
    <flag contact="enable" energy="enable"/>
  </option>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" width="512" height="512" rgb1=".15 .18 .2" rgb2=".25 .28 .3"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="8 8" reflectance="0.2"/>
    <material name="wall_mat" rgba="0.1 0.5 0.9 1" specular="0.5" shininess="0.5"/>
    <material name="ball_mat" rgba="0.2 0.9 0.9 1" specular="0.8" shininess="0.8"/>
    <material name="target_mat" rgba="0.1 0.9 0.2 0.8"/>
  </asset>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <worldbody>
    <light directional="true" pos="0 0 6" dir="0 0 -1"/>
    
    <geom name="floor" type="plane" size="8 8 0.1" material="floor_mat" friction="1.0 0.005 0.0001"/>

    <geom name="wall_n" type="box" pos="0 8 0.5" size="8 0.2 0.5" material="wall_mat"/>
    <geom name="wall_s" type="box" pos="0 -8 0.5" size="8 0.2 0.5" material="wall_mat"/>
    <geom name="wall_e" type="box" pos="8 0 0.5" size="0.2 8 0.5" material="wall_mat"/>
    <geom name="wall_w" type="box" pos="-8 0 0.5" size="0.2 8 0.5" material="wall_mat"/>

    <body name="target" pos="4 4 0.01">
      <geom name="target_geom" type="cylinder" size="0.5 0.01" material="target_mat" conaffinity="0" contype="0"/>
    </body>

    <body name="ball_agent" pos="-4 -4 0.2">
      <freejoint name="agent_joint"/>
      <geom name="agent_geom" type="sphere" size="0.2" mass="100.0" material="ball_mat"
            friction="1.0 0.005 0.0001"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor_x" joint="agent_joint" gear="500 0 0 0 0 0" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="motor_y" joint="agent_joint" gear="0 500 0 0 0 0" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
